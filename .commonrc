# =============================================================================
# .commonrc — shared shell configuration (bash + zsh)
#
# Sourced by .bashrc and .zshrc alike.
# Contains: PATH, exports, aliases, functions — everything shell-agnostic.
#
# QNAP-specific: Entware lives under /opt; not in the default PATH.
# =============================================================================

# ── Entware PATH (QNAP) ──────────────────────────────────────────────────────
case ":$PATH:" in
  *:/opt/bin:*) ;;
  *) export PATH="/opt/bin:/opt/sbin:$PATH" ;;
esac

# ── Shell ────────────────────────────────────────────────────────────────────
export SHELL="$(command -v bash 2>/dev/null || command -v sh)"
export PAGER="less"
export LESS="-R"

# ── Editor: Entware-vim > busybox vi > vi
#    QNAP-System-vim (/bin/vim → QPKG vim 7.2) hat kaputtes TTY-Handling
#    und wird bewusst übersprungen.
_pick_editor() {
  if   [ -x /opt/bin/vim ];  then echo /opt/bin/vim
  elif busybox --list 2>/dev/null | grep -q '^vi$'; then echo 'busybox vi'
  else echo vi
  fi
}
export EDITOR="$(_pick_editor)"
unset -f _pick_editor

# vim/vi aliase: Entware-vim wenn vorhanden, sonst busybox vi
# Verhindert Aufruf von /bin/vim (QNAP-QPKG, TTY-Problem)
if [ -x /opt/bin/vim ]; then
  alias vim='/opt/bin/vim'
  alias vi='/opt/bin/vim'
else
  alias vim='busybox vi'
  alias vi='busybox vi'
fi

# ── Locale ───────────────────────────────────────────────────────────────────
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"

# ── History ──────────────────────────────────────────────────────────────────
export HISTSIZE=10000
export HISTFILESIZE=20000
export HISTCONTROL="ignoredups:erasedups"

# ── Aliases: Navigation ──────────────────────────────────────────────────────
alias ..='cd ..'
alias ...='cd ../..'
alias ll='ls -lAh'
alias la='ls -A'
alias l='ls -CF'

# ── Aliases: Safety ──────────────────────────────────────────────────────────
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

# ── Aliases: QNAP-specific ───────────────────────────────────────────────────
alias git='/opt/bin/git'
alias snap='/opt/bin/qnap-config-keeper.sh snap'
alias keeper-status='/opt/bin/qnap-config-keeper.sh status'
alias keeper-audit='/opt/bin/qnap-config-keeper.sh audit'

# ── Helpers ──────────────────────────────────────────────────────────────────
path_show() { echo "$PATH" | tr ':' '\n'; }
